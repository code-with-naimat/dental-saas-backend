# Master DB (control/billing DB — clinics, admins, subscriptions)
MASTER_DB_URI=mongodb://127.0.0.1:27017/dental_saas_master

# Base URI used to build each clinic's own database
# Clinic DB name will be appended automatically, e.g. dental_clinic_<clinicId>
TENANT_DB_BASE_URI=mongodb://127.0.0.1:27017

# JWT secret for auth tokens
JWT_SECRET=change_this_to_a_long_random_string

# Server port
PORT=5000

# Anthropic API key (AI Receptionist ke liye — chat aur voice dono use karte hain)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twilio (voice calls ke liye) — signup: twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (reminders + invoices ke liye) — Gmail App Password ya koi SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# App base URL (payment redirects ke liye)
APP_BASE_URL=http://localhost:5000

# Stripe (international payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# JazzCash (local Pakistan payments) — sandbox account: developer.jazzcash.com.pk
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# EasyPaisa (local Pakistan payments) — merchant portal se milega
EASYPAISA_ENV=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
